# Copy to .env and fill in real values. .env is gitignored.

# Traefik API — reachable by the container over the internal Docker network,
# passed in via docker/docker-compose.yml's env_file.
TRAEFIK_API_URL=http://traefik:8080

# Same, but for `npm run dev` (outside Docker) — `traefik` only resolves on
# the Docker network, so point this at wherever the API is reachable from
# your host machine when developing locally.
VITE_TRAEFIK_API_URL=http://localhost:8080

# Optional: override window.location.hostname to exclude the dashboard's own
# domain when testing locally under a hostname that isn't the real one.
VITE_DASHBOARD_HOSTNAME=

# Dev-only: skip fetching Traefik entirely and render generic placeholder
# cards, for previewing the design without a working Traefik connection.
# Has no effect outside `npm run dev` (ignored in production builds).
VITE_MOCK_DATA=false

# Domain, Traefik entrypoint, and Docker network are hardcoded in
# docker/docker-compose.yml, not read from here.
